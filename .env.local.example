# Copie ce fichier en ".env.local" (à la racine du projet) et remplis
# les valeurs avec tes propres clés Twitch. Voir le README, section
# "Détection automatique du live Twitch", pour savoir où les trouver.
# Ce fichier .env.local ne doit JAMAIS être partagé ni mis sur GitHub
# (il est déjà exclu automatiquement par .gitignore).

TWITCH_CLIENT_ID=colle_ton_client_id_ici
TWITCH_CLIENT_SECRET=colle_ton_client_secret_ici

# Optionnel : nom exact de ta chaîne Twitch (celui dans l'URL,
# twitch.tv/cycylive -> "cycylive"). Par défaut : "cycylive".
TWITCH_CHANNEL_LOGIN=cycylive

# Mot de passe pour accéder à l'interface /admin (planning).
# Choisis n'importe quel mot de passe, garde-le pour toi.
ADMIN_PASSWORD=choisis_un_mot_de_passe

# Ces deux valeurs viennent directement de la page "REST API" de ta
# base de données sur upstash.com (voir README, section "Interface
# d'administration du planning"). Copie-les exactement comme
# Upstash te les donne, sans changer les noms.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optionnel : pour le compteur "membres en ligne sur Discord" affiché
# sur l'accueil et /statistiques (voir README, section "Statistiques
# et compteur Discord").
DISCORD_SERVER_ID=

# Pour l'envoi réel du formulaire de contact (voir README, section
# "Formulaire de contact").
RESEND_API_KEY=
# Optionnel (recommandé une fois ton domaine vérifié sur Resend) :
RESEND_FROM_EMAIL=
